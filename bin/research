#!/usr/bin/env python3
"""Research CLI for analyst agent. Usage: research <command> [args]"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.config import Config
from lib.alpaca_client import AlpacaClient

cfg = Config()
client = AlpacaClient(cfg)


def cmd_screen():
    symbols = [
        "AAPL", "MSFT", "GOOGL", "AMZN", "NVDA", "META", "TSLA", "JPM", "V", "WMT",
        "JNJ", "MA", "PG", "UNH", "HD", "BAC", "DIS", "ADBE", "CRM", "NFLX",
        "SPY", "QQQ", "IWM", "DIA", "TLT", "IEF", "GLD", "SLV", "USD", "XLF",
        "XLE", "XLK", "XLV", "XLI", "XLP", "XLY", "XLB", "XLRE", "XLU", "VTI",
        "ARKK", "SOXX", "SMH", "IBB", "KRE", "JETS", "BITO", "COIN", "MSTR", "PLTR",
    ]
    try:
        snapshots = client.get_snapshots(symbols)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)

    results = []
    for sym, data in snapshots.items():
        if not data or "dailyBar" not in data:
            continue
        db = data["dailyBar"]
        lq = data.get("latestQuote", {}) or data.get("latestTrade", {})
        price = lq.get("p", db.get("c", 0))
        change_pct = (db["c"] - db["o"]) / db["o"] * 100
        results.append({
            "symbol": sym,
            "price": round(price, 2),
            "change_pct": round(change_pct, 2),
            "volume": db.get("v", 0),
            "high": db.get("h", 0),
            "low": db.get("l", 0),
        })

    results.sort(key=lambda r: abs(r["change_pct"]), reverse=True)
    print(json.dumps({"symbols": results}, indent=2))


def cmd_bars():
    if len(sys.argv) < 3:
        print("Usage: research bars <symbol> [timeframe=5Min] [limit=20]")
        sys.exit(1)
    symbol = sys.argv[2]
    tf = sys.argv[3] if len(sys.argv) > 3 else "5Min"
    limit = int(sys.argv[4]) if len(sys.argv) > 4 else 20
    try:
        bars = client.get_bars(symbol, timeframe=tf, limit=limit)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    print(json.dumps({"symbol": symbol, "timeframe": tf, "bars": bars}, indent=2, default=str))


def cmd_snapshot():
    if len(sys.argv) < 3:
        print("Usage: research snapshot <symbol>")
        sys.exit(1)
    symbol = sys.argv[2]
    try:
        snap = client.get_snapshots([symbol])
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    print(json.dumps(snap.get(symbol, {}), indent=2, default=str))


def cmd_asset():
    if len(sys.argv) < 3:
        print("Usage: research asset <symbol>")
        sys.exit(1)
    symbol = sys.argv[2]
    try:
        asset = client.get_asset(symbol)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    print(json.dumps(asset, indent=2, default=str))


def cmd_quote():
    if len(sys.argv) < 3:
        print("Usage: research quote <symbol>")
        sys.exit(1)
    symbol = sys.argv[2]
    try:
        quote = client.get_quote(symbol)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    print(json.dumps(quote, indent=2, default=str))


def cmd_indicators():
    if len(sys.argv) < 3:
        print("Usage: research indicators <symbol> [timeframe=5Min] [limit=50]")
        sys.exit(1)
    symbol = sys.argv[2]
    tf = sys.argv[3] if len(sys.argv) > 3 else "5Min"
    limit = int(sys.argv[4]) if len(sys.argv) > 4 else 50
    try:
        bars = client.get_bars(symbol, timeframe=tf, limit=limit)
        daily_bars = client.get_bars(symbol, timeframe="1Day", limit=50)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    from lib.indicators import compute_all
    result = compute_all(bars, daily_bars)
    result["symbol"] = symbol
    print(json.dumps(result, indent=2, default=str))


def cmd_regime():
    try:
        spy_bars = client.get_bars("SPY", timeframe="1Day", limit=50)
        qqq_bars = client.get_bars("QQQ", timeframe="1Day", limit=50)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    from lib.indicators import ema
    spy_close = [b.get("c", 0) for b in spy_bars]
    qqq_close = [b.get("c", 0) for b in qqq_bars]
    spy_e20 = ema(spy_close, 20)
    spy_e50 = ema(spy_close, 50)
    qqq_e20 = ema(qqq_close, 20)
    qqq_e50 = ema(qqq_close, 50)

    def regime(e20, e50):
        if e20 is None or e50 is None:
            return "unknown"
        return "uptrend" if e20 > e50 else "downtrend"

    print(json.dumps({
        "spy": {"regime": regime(spy_e20[-1], spy_e50[-1]), "ema_20": round(spy_e20[-1], 2), "ema_50": round(spy_e50[-1], 2)},
        "qqq": {"regime": regime(qqq_e20[-1], qqq_e50[-1]), "ema_20": round(qqq_e20[-1], 2), "ema_50": round(qqq_e50[-1], 2)},
    }, indent=2))


def cmd_screener():
    from lib.universe import screen_dynamic
    min_vol = int(sys.argv[2]) if len(sys.argv) > 2 else 500_000
    min_price = float(sys.argv[3]) if len(sys.argv) > 3 else 5.0
    try:
        result = screen_dynamic(client, min_vol, min_price)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    print(json.dumps(result, indent=2, default=str))


def cmd_news():
    symbols = None
    limit = 20
    i = 1
    while i < len(sys.argv):
        if sys.argv[i] == "--symbols" and i + 1 < len(sys.argv):
            symbols = sys.argv[i + 1].split(",")
            i += 2
        elif sys.argv[i] == "--limit" and i + 1 < len(sys.argv):
            limit = int(sys.argv[i + 1])
            i += 2
        else:
            i += 1
    try:
        if symbols:
            news = client.get_news(symbols, limit)
        else:
            news = client.get_market_news(limit)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    print(json.dumps({"count": len(news), "news": news}, indent=2, default=str))


def cmd_backtest():
    if len(sys.argv) < 3:
        print("Usage: research backtest <symbol> [timeframe=1Day] [limit=100]")
        sys.exit(1)
    symbol = sys.argv[2]
    tf = sys.argv[3] if len(sys.argv) > 3 else "1Day"
    limit = int(sys.argv[4]) if len(sys.argv) > 4 else 100
    try:
        bars = client.get_bars(symbol, timeframe=tf, limit=limit)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    if len(bars) < 30:
        print(json.dumps({"error": f"Need at least 30 bars, got {len(bars)}"}))
        sys.exit(1)
    from lib.backtest import Backtester
    bt = Backtester(bars)
    results = bt.run_all()
    output = {
        "symbol": symbol,
        "bars": len(bars),
        "timeframe": tf,
        "strategies": [r.to_dict() for r in results],
    }
    if results:
        best = max(results, key=lambda r: r.sharpe)
        output["recommendation"] = best.strategy
        output["best_sharpe"] = best.sharpe
    print(json.dumps(output, indent=2, default=str))


def cmd_signals():
    if len(sys.argv) < 3:
        print("Usage: research signals <symbol> [timeframe=5Min]")
        sys.exit(1)
    symbol = sys.argv[2]
    tf = sys.argv[3] if len(sys.argv) > 3 else "5Min"
    try:
        bars = client.get_bars(symbol, timeframe=tf, limit=50)
        daily_bars = client.get_bars(symbol, timeframe="1Day", limit=50)
        snap = client.get_snapshots([symbol])
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    from lib.indicators import compute_all
    from lib.laya_signals import classify_signal
    indicators = compute_all(bars, daily_bars)
    sd = snap.get(symbol, {})
    db = sd.get("dailyBar", {})
    lq = sd.get("latestQuote", {}) or sd.get("latestTrade", {})
    price = lq.get("p", db.get("c", 0))
    change_pct = (db["c"] - db["o"]) / db["o"] * 100 if db.get("o") else 0

    # Get regime
    try:
        spy_bars = client.get_bars("SPY", timeframe="1Day", limit=50)
        from lib.indicators import ema as _ema
        spy_close = [b.get("c", 0) for b in spy_bars]
        spy_e20 = _ema(spy_close, 20)
        spy_e50 = _ema(spy_close, 50)
        regime = "uptrend" if spy_e20[-1] and spy_e50[-1] and spy_e20[-1] > spy_e50[-1] else "downtrend"
    except Exception:
        regime = "unknown"

    signal = classify_signal(symbol, price, change_pct, indicators, regime)
    signal["indicators"] = {
        "rsi_14": indicators.get("rsi_14"),
        "trend": indicators.get("trend_signal"),
        "atr_14": indicators.get("atr_14"),
        "vwap": indicators.get("vwap"),
    }
    signal["regime"] = regime
    print(json.dumps(signal, indent=2, default=str))


def cmd_assess():
    if len(sys.argv) < 3:
        print("Usage: research assess <symbol> [--pnl PCT] [--age DAYS] [--regime REGIME]")
        sys.exit(1)
    symbol = sys.argv[2]
    pnl_pct = 0.0
    age = 1
    regime = "unknown"
    i = 3
    while i < len(sys.argv):
        if sys.argv[i] == "--pnl" and i + 1 < len(sys.argv):
            pnl_pct = float(sys.argv[i + 1])
            i += 2
        elif sys.argv[i] == "--age" and i + 1 < len(sys.argv):
            age = int(sys.argv[i + 1])
            i += 2
        elif sys.argv[i] == "--regime" and i + 1 < len(sys.argv):
            regime = sys.argv[i + 1]
            i += 2
        else:
            i += 1
    try:
        positions = client.get_positions()
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    pos = None
    for p in positions:
        if p["symbol"] == symbol:
            pos = p
            break
    if not pos:
        print(json.dumps({"error": f"No position in {symbol}"}))
        sys.exit(1)
    from lib.laya_signals import assess_risk
    entry = float(pos["cost_basis"]) / float(pos["qty"])
    current = float(pos["market_value"]) / float(pos["qty"])
    result = assess_risk(
        symbol=symbol,
        side="long",
        qty=int(float(pos["qty"])),
        entry_price=entry,
        current_price=current,
        pnl_pct=pnl_pct if pnl_pct else float(pos["unrealized_plpc"]) * 100,
        position_age_days=age,
        market_regime=regime,
    )
    print(json.dumps(result, indent=2, default=str))


def cmd_triage():
    if len(sys.argv) < 3:
        print("Usage: research triage <symbol>")
        sys.exit(1)
    symbol = sys.argv[2]
    try:
        bars = client.get_bars(symbol, timeframe="1Day", limit=50)
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
    from lib.indicators import compute_all, ema as _ema
    indicators = compute_all(bars)
    spy_bars = client.get_bars("SPY", timeframe="1Day", limit=50)
    spy_close = [b.get("c", 0) for b in spy_bars]
    spy_e20 = _ema(spy_close, 20)
    spy_e50 = _ema(spy_close, 50)
    regime = "uptrend" if spy_e20[-1] and spy_e50[-1] and spy_e20[-1] > spy_e50[-1] else "downtrend"
    from lib.laya_signals import triage_symbol
    result = triage_symbol(symbol, "unknown", indicators, regime)
    result["regime"] = regime
    print(json.dumps(result, indent=2, default=str))


def cmd_eval():
    import argparse
    from lib.laya_eval import run_eval, HORIZON_HOURS_DEFAULT, THRESHOLD_PCT_DEFAULT
    parser = argparse.ArgumentParser(prog="research eval", add_help=True)
    parser.add_argument("mode", nargs="?", default="all", choices=["risk", "signal", "all"])
    parser.add_argument("--horizon", type=float, default=HORIZON_HOURS_DEFAULT,
                        help="forward-return horizon in hours (default: 4)")
    parser.add_argument("--threshold", type=float, default=THRESHOLD_PCT_DEFAULT,
                        help="flat-band threshold in percent (default: 0.5)")
    parser.add_argument("--max", type=int, default=None, dest="max_cases",
                        help="cap cases per track")
    parser.add_argument("--no-laya", action="store_true",
                        help="build cases + baselines only, skip model calls")
    args = parser.parse_args(sys.argv[2:])
    summary = run_eval(
        mode=args.mode,
        client=client,
        reports_dir=Path(cfg.reports_dir),
        horizon_hours=args.horizon,
        threshold_pct=args.threshold,
        max_cases=args.max_cases,
        use_laya=not args.no_laya,
    )
    print(json.dumps(summary, indent=2, default=str))


def _regime_from_spy():
    spy_bars = client.get_bars("SPY", timeframe="1Day", limit=50)
    spy_close = [b.get("c", 0) for b in spy_bars]
    from lib.indicators import ema as _ema
    e20 = _ema(spy_close, 20)
    e50 = _ema(spy_close, 50)
    if e20[-1] is None or e50[-1] is None:
        return "unknown"
    return "uptrend" if e20[-1] > e50[-1] else "downtrend"


def cmd_shadow_log():
    """Log Laya states for candidate symbols — including ones we won't trade."""
    import argparse
    from datetime import datetime, timezone
    parser = argparse.ArgumentParser(prog="research shadow-log")
    parser.add_argument("--top", type=int, default=15, dest="top_n",
                        help="candidates per cycle (default: 15, ranked by |change|)")
    parser.add_argument("--symbols", default=None,
                        help="comma list to log instead of the screened top movers")
    parser.add_argument("--tf", default="5Min", help="indicator timeframe (default: 5Min)")
    parser.add_argument("--skip-if-closed", action="store_true",
                        help="exit early when reports/clock.json says the market is shut")
    args = parser.parse_args(sys.argv[2:])

    if args.skip_if_closed:
        clock_file = Path(cfg.reports_dir) / "clock.json"
        try:
            is_open = json.loads(clock_file.read_text()).get("is_open", False)
        except (OSError, json.JSONDecodeError):
            is_open = False
        if not is_open:
            print(json.dumps({"logged": 0, "skipped": "market closed"}))
            return

    from lib.indicators import compute_all
    from lib.laya_signals import BACKEND, LAYA_CPU_MODEL, classify_signal
    from lib import shadow_log as slog
    from lib.universe import screen_dynamic, sector_exposure_map, sector_of

    try:
        if args.symbols:
            symbols = [s.strip().upper() for s in args.symbols.split(",") if s.strip()]
        else:
            screen = screen_dynamic(client)
            symbols = [r["symbol"] for r in screen.get("top_movers", [])][:args.top_n]
        if not symbols:
            print(json.dumps({"error": "no candidate symbols", "logged": 0}))
            return
        regime = _regime_from_spy()
        exposure = sector_exposure_map(client)
        try:
            held = {p.get("symbol") for p in client.get_positions()}
        except Exception:
            held = set()
    except Exception as e:
        print(json.dumps({"error": str(e), "logged": 0}))
        sys.exit(1)

    ts = datetime.now(timezone.utc)
    rows = []
    errors = 0
    for sym in symbols:
        try:
            bars = client.get_bars(sym, timeframe=args.tf, limit=50)
            daily = client.get_bars(sym, timeframe="1Day", limit=50)
            if len(bars) < 30:
                errors += 1
                continue
            indicators = compute_all(bars, daily)
            snap = client.get_snapshots([sym]).get(sym, {})
            db = snap.get("dailyBar", {})
            lq = snap.get("latestQuote", {}) or snap.get("latestTrade", {})
            price = float(lq.get("p") or db.get("c") or 0)
            change_pct = ((db["c"] - db["o"]) / db["o"] * 100) if db.get("o") else 0.0
        except Exception as e:
            errors += 1
            print(f"shadow-log {sym}: {e}", file=sys.stderr)
            continue
        if price <= 0:
            errors += 1
            continue
        sector = sector_of(sym)
        signal = classify_signal(sym, price, change_pct, indicators, regime)
        if signal.get("error"):
            errors += 1
        rows.append(slog.build_row(
            symbol=sym, ts=ts, price=price, change_pct=change_pct,
            indicators=indicators, regime=regime, sector=sector,
            sector_exposure_pct=exposure.get(sector, 0.0),
            held=sym in held, signal=signal, backend=BACKEND,
        ))

    header = {
        "schema_version": slog.SHADOW_SCHEMA_VERSION,
        "generated_at": ts.isoformat(),
        "backend": BACKEND,
        "model": str(LAYA_CPU_MODEL),
        "regime": regime,
        "universe_source": "explicit" if args.symbols else "screener_top_movers",
        "indicator_timeframe": args.tf,
        "n_cases": len(rows),
    }
    path = slog.append_cases(Path(cfg.reports_dir), rows, header=header) if rows else None
    actions: dict[str, int] = {}
    for r in rows:
        actions[str(r["action"])] = actions.get(str(r["action"]), 0) + 1
    print(json.dumps({
        "logged": len(rows),
        "errors": errors,
        "backend": BACKEND,
        "regime": regime,
        "timeframe": args.tf,
        "actions": actions,
        "symbols": [r["symbol"] for r in rows],
        "n_held": sum(1 for r in rows if r["held"]),
        "file": str(path) if path else None,
    }, indent=2, default=str))


def cmd_shadow_score():
    """Join forward outcomes onto logged shadow cases and score them."""
    import argparse
    from lib import shadow_log as slog
    from lib.laya_eval import HORIZON_HOURS_DEFAULT, THRESHOLD_PCT_DEFAULT
    parser = argparse.ArgumentParser(prog="research shadow-score")
    parser.add_argument("--horizon", type=float, default=HORIZON_HOURS_DEFAULT)
    parser.add_argument("--threshold", type=float, default=THRESHOLD_PCT_DEFAULT)
    parser.add_argument("--since", default=None, help="only score shards from YYYY-MM-DD.ndjson onward")
    args = parser.parse_args(sys.argv[2:])
    summary = slog.run_score(
        reports_dir=Path(cfg.reports_dir), client=client,
        horizon_hours=args.horizon, threshold_pct=args.threshold, since=args.since,
    )
    print(json.dumps(summary, indent=2, default=str))


def cmd_help():
    print("""Research CLI — Analyst Agent Tools

Usage:
  research screen                        Scan hardcoded universe (legacy)
  research screener [min_vol] [min_p]    Dynamic screening: volume, momentum, new highs, sector leaders
  research bars <sym> [tf] [n]           Get price bars (default: 5Min, 20 bars)
  research snapshot <sym>                Get current snapshot (daily bar + latest quote/trade)
  research asset <sym>                   Get asset/tradability info
  research quote <sym>                   Get latest quote
  research indicators <sym> [tf] [n]     Compute technical indicators (RSI, EMA, ATR, VWAP, BB)
  research regime                        Get market regime (SPY/QQQ trend via 20/50 EMA)
  research news [--symbols X,Y] [--limit N]  Get market or symbol-specific news
  research backtest <sym> [tf] [n]       Backtest strategies on historical bars
  research signals <sym> [tf]            Laya AI signal classification (buy/sell/hold + conviction)
  research assess <sym> [--pnl PCT]      Laya AI risk assessment for open position
  research triage <sym>                  Laya AI priority triage for symbol
  research eval [risk|signal|all]        Replay Laya on logged states, score vs forward returns
                                         [--horizon H] [--threshold PCT] [--max N] [--no-laya]
  research shadow-log [--top N]          Log Laya states for candidate symbols (incl. skipped ones)
                                         [--symbols A,B] [--tf 5Min] [--skip-if-closed]
                                         — appends reports/shadow/*.ndjson
  research shadow-score                  Score logged shadow cases vs forward returns
                                         [--horizon H] [--threshold PCT] [--since YYYY-MM-DD]
""")


CMDS = {
    "screen": cmd_screen,
    "screener": cmd_screener,
    "bars": cmd_bars,
    "snapshot": cmd_snapshot,
    "asset": cmd_asset,
    "quote": cmd_quote,
    "indicators": cmd_indicators,
    "regime": cmd_regime,
    "news": cmd_news,
    "backtest": cmd_backtest,
    "signals": cmd_signals,
    "assess": cmd_assess,
    "triage": cmd_triage,
    "eval": cmd_eval,
    "shadow-log": cmd_shadow_log,
    "shadow-score": cmd_shadow_score,
    "help": cmd_help,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        cmd_help()
        sys.exit(1)
    CMDS[sys.argv[1]]()
